# Copy to .env and adjust. Never commit .env.
DB_NAME=shortener
DB_USER=shortener
DB_PASSWORD=change-me-locally
DB_URL=jdbc:postgresql://localhost:5432/shortener
PUBLIC_BASE_URL=http://localhost:8080

# Demo mode needs no AI credentials. Leave these blank to use the deterministic mock agents.
AGENT_PROVIDER=mock
# Optional external AI provider (AGENT_PROVIDER=llm). Maps to shortener.agents.llm.* Spring properties:
# LLM_ENDPOINT -> endpoint (required for llm), LLM_API_KEY -> api-key (sent as Bearer token), LLM_MODEL -> model
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# Optional: speeds up the OWASP dependency check (free key from the NVD)
NVD_API_KEY=
